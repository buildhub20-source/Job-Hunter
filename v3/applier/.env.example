# Same values as the dashboard. Copy from v3/dashboard/.env
SHEET_API_URL=https://script.google.com/macros/s/XXXX/exec
SHEET_API_TOKEN=xxxxxxxxxxxxxxxx

# Discord: where blocked jobs ask their questions. The bot posts one message per job;
# reply to it ("1: No") and `npm run apply` or `npm run answers` picks the answers up.
# The bot needs Send Messages, Read Message History and the Message Content intent.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Only replies from these Discord user IDs (comma-separated) count — the answers go
# into real applications. Discord: Settings → Advanced → Developer Mode, then
# right-click your name → Copy User ID.
DISCORD_ALLOWED_USER_IDS=

# Fallback when there's no bot: questions are posted, but replies can't be read.
DISCORD_WEBHOOK_URL=

