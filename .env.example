# --- Database (operational state only; never personal facts) ---
DATABASE_URL=postgresql://jobops:jobops@localhost:5432/jobops

# --- Markdown source of truth ---
JOBOPS_DATA_DIR=./data
JOBOPS_GIT_COMMIT_ON_WRITE=true

# --- API / dashboard ---
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Google Chat ---
# Auth is Application Default Credentials with service-account impersonation, not a
# downloaded key file — this org enforces iam.disableServiceAccountKeyCreation. Set up
# once with:
#   gcloud auth application-default login \
#     --impersonate-service-account=jobservice@jobhunter-508210.iam.gserviceaccount.com
GCHAT_SPACE_ID=

# --- Evaluator (step 8) ---
ANTHROPIC_API_KEY=

# --- Gmail inbox worker (step 9) ---
# gopir525@gmail.com — Vinoth's mailbox, not the operator's. Run
# `npm run authorize -w @jobops/inbox` once, interactively, to populate
# GMAIL_TOKEN_PATH — and do that on Vinoth's own machine, not the one this was built
# on (D12).
GMAIL_USER=gopir525@gmail.com
GMAIL_OAUTH_CLIENT_PATH=secrets/client_secret.json
GMAIL_TOKEN_PATH=secrets/.gmail-token.json

# --- Google Chat webhook auth ---
# Production: your Google Cloud project NUMBER (verifies Google's signed JWT).
GCHAT_PROJECT_NUMBER=
# Local only: shared secret used when no project number is set.
GCHAT_WEBHOOK_SECRET=
DASHBOARD_URL=http://localhost:3000
